  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Traffic (requests/sec)",
      "description": "Golden signal: request traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(quiz_http_requests_total{environment=\"$environment\",route!=\"/metrics\",route!=\"/api/healthz\"}[$__rate_interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "5xx error rate",
      "description": "Golden signal: server error percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(quiz_http_requests_total{environment=\"$environment\",status_code=~\"5..\",route!=\"/metrics\",route!=\"/api/healthz\"}[$__rate_interval])) / clamp_min(sum(rate(quiz_http_requests_total{environment=\"$environment\",route!=\"/metrics\",route!=\"/api/healthz\"}[$__rate_interval])), 0.0001)",
          "refId": "A"
        }
      ]
    },
    {
